# PostgreSQL 数据库连接地址
DB_URL=postgresql+asyncpg://postgres:your_password@localhost:5432/alphascout_db

# 网络代理配置 (HTTP / SOCKS5)
PROXY_URL=http://127.0.0.1:7890

# Twitter (X) 监控参数
TWITTER_POLL_INTERVAL_MINUTES=20
TWITTER_BATCH_SIZE=10
TWITTER_DELAY_MIN=8.0
TWITTER_DELAY_MAX=18.0
TWITTER_AUTH_TOKEN=your_twitter_auth_token_cookie_here

# LLM (DeepSeek / OpenAI) 密钥
DEEPSEEK_API_KEY=your_deepseek_api_key_here
DEEPSEEK_API_BASE=https://api.deepseek.com/v1

# 消息推送配置
TG_BOT_TOKEN=your_telegram_bot_token_here
TG_CHAT_ID=your_telegram_chat_id_here
FEISHU_WEBHOOK_URL=https://open.feishu.cn/open-apis/bot/v2/hook/your_hook_id